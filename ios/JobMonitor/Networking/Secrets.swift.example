import Foundation

/// Локальный файл с значениями по умолчанию для первого запуска — НЕ комитится
/// в git (см. .gitignore). Скопируйте этот файл в `Secrets.swift` рядом и
/// подставьте реальный API-токен, чтобы приложению не пришлось вводить его
/// вручную в Настройках при первом запуске на устройстве.
///
///   cp Secrets.swift.example Secrets.swift
///   # затем впишите значение ниже в Secrets.swift
///
/// Если оставить пустой строкой (как здесь) — приложение просто попросит
/// ввести токен вручную, ничего не сломается.
enum Secrets {
    static let defaultAPIToken = ""
}
