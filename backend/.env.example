# Копия этого файла должна называться .env и не должна коммититься в git.

# База данных (SQLite по умолчанию — файл в data/db.sqlite)
DATABASE_URL="file:./data/db.sqlite"

# Токен, которым iOS-приложение авторизуется в API (любая длинная случайная строка)
API_AUTH_TOKEN="change-me-to-a-long-random-string"

# SuperJob API — зарегистрируйте приложение на https://api.superjob.ru/ и вставьте ключ
SUPERJOB_API_KEY=""

# SMTP для отправки email-дайджеста (пример для Gmail: используйте пароль приложения,
# а не обычный пароль аккаунта — https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Job Monitor <you@example.com>"
MAIL_TO="V_utkin@castleduck.com"

# Таймзона для ежедневного скана в 10:00 (IANA-имя)
CRON_TZ="Europe/Moscow"

# Порт, на котором слушает backend
PORT="4000"
