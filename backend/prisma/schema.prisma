generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Список названий должностей, которые пользователь ведёт заранее.
// При поиске используются только те, у которых selected = true.
model JobTitle {
  id        String   @id @default(cuid())
  title     String   @unique
  selected  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Остальные критерии поиска (без свободного текста по названию должности —
// оно берётся из выбранных JobTitle). Единственная запись в таблице.
model SearchCriteria {
  id        String   @id @default("singleton")
  // JSON-массивы строк (например ["Россия","Казахстан"]) — хранятся как
  // текст по тому же принципу, что и Source.config, т.к. SQLite не
  // поддерживает нативные списки в Prisma. Пустой список = без ограничения
  // по этому полю (поиск ведётся по всем направлениям).
  countries String   @default("[]")
  cities    String   @default("[]")
  updatedAt DateTime @updatedAt
}

model Vacancy {
  id               String         @id @default(cuid())
  hiringResourceId String
  hiringResource   HiringResource @relation(fields: [hiringResourceId], references: [id])
  externalId       String
  title            String
  company          String?
  url              String
  location         String?
  salaryText       String?
  publishedAt      DateTime
  firstSeenAt      DateTime       @default(now())
  lastSeenAt       DateTime       @default(now())

  state             VacancyState?
  notificationLog   NotificationLog?

  @@unique([hiringResourceId, externalId])
  @@index([publishedAt])
}

model VacancyState {
  vacancyId String   @id
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  hidden    Boolean  @default(false)
  // false, пока пользователь не открывал список вакансий после появления этой
  // записи — управляет значком "Новое" и счётчиком в приложении.
  seen      Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Наличие записи означает, что по этой вакансии уже было отправлено письмо.
model NotificationLog {
  vacancyId  String   @id
  vacancy    Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  notifiedAt DateTime @default(now())
}

// Журнал запусков скана — для отображения в приложении времени/результата последнего скана.
model ScanRun {
  id           String   @id @default(cuid())
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  trigger      String // "cron" | "manual"
  newVacancies Int      @default(0)
  emailSent    Boolean  @default(false)
  error        String?
}

// ==== Поиск и верификация РЕСУРСОВ НАЙМА (не вакансий) ====
// Находит и проверяет ресурсы, которые нанимают, подбирают персонал для
// клиентов или публикуют вакансии — сайты, каналы, сообщества, соцстраницы.
// Единица результата — ресурс, а не вакансия (см.
// src/discovery/hiringResourceAgent.ts). Подтверждённые записи категорий
// direct_employer/job_board/community/social/telegram — это и есть источники
// для скана вакансий (см. Vacancy.hiringResource и src/jobs/scan.ts),
// SourceRecord для коннектора строится на лету из полей ниже, без отдельной
// технической записи.

// Организация — для дедупликации: сайт агентства и его Telegram-канал
// физически разные ресурсы (HiringResource), но могут принадлежать одной
// организации. Итоги считают ресурсы и организации отдельно (п.8 требования).
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  resources HiringResource[]
}

model HiringResource {
  id   String @id @default(cuid())
  name String
  // Нормализованный адрес (без меток/редиректов) — по нему определяются дубли.
  url  String @unique

  // "recruiting_agency" | "hr_agency" | "direct_employer" | "telegram" |
  // "community" | "social" | "job_board"
  category String
  // JSON-массив ролей ресурса (можно несколько): "hires_own" |
  // "sources_for_clients" | "distributes_vacancies"
  roles    String @default("[]")

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // География найма (где ищут сотрудников) — отдельно от местонахождения
  // самой организации/агентства, как требует п.7.
  hiringGeography String?
  agencyLocation  String?
  specialization  String?

  evidenceSummary  String
  evidenceUrl      String
  lastRelevantDate DateTime?
  contactMethod    String?
  publicContact    String?

  // Явная конфигурация коннектора для скана вакансий, например
  // {"connector":"headhunter","areaId":113} или {"connector":"ats_board",
  // "provider":"greenhouse","boardSlug":"acme"} — только для источников с
  // техническим API/фидом (hh.ru, SuperJob, Habr Career, ATS-доски,
  // RSS-ленты), заводимых сидом или вручную. Если не задано, src/jobs/scan.ts
  // сам выводит коннектор из category (generic_site/telegram_channel) — так
  // работают ресурсы, которые находит ИИ-агент.
  scanConfig String?

  // "confirmed" | "needs_review" | "excluded"
  status          String
  exclusionReason String?
  relatedResources String? // JSON-массив URL связанных ресурсов той же организации
  uncertainties   String?

  score         Int @default(0)
  scoreGeoSpec  Int @default(0) // соответствие географии/специализации, до 30
  scoreEvidence Int @default(0) // убедительность доказательств, до 30
  scoreRecency  Int @default(0) // актуальность, до 25
  scoreContact  Int @default(0) // способ обращения, до 15

  // Найден в этом запуске впервые — снимается GET /api/hiring-resources/mark-all-seen
  // (тот же паттерн, что и isNew у Vacancy).
  isNew Boolean @default(true)
  // true, если ресурс был подтверждён/на проверке в одном из прошлых запусков,
  // чья область поиска (категория) пересекается с последним запуском, но сам
  // ресурс не был повторно найден/подтверждён в этом запуске — то есть
  // "перестал откликаться при поиске". Сбрасывается в false, как только
  // ресурс снова встречается в результатах.
  isStale Boolean @default(false)

  checkedAt   DateTime @default(now())
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runId String?
  run   HiringResourceRun? @relation(fields: [runId], references: [id])

  vacancies Vacancy[]

  @@index([category])
  @@index([status])
  @@index([organizationId])
}

// Журнал запусков поиска ресурсов найма — хранит заданные параметры (п.1,
// с явными допущениями там, где параметр не задан) и итоговый отчёт (п.10):
// сколько найдено по каждому статусу, какие фильтры использовались,
// ограничения доступа и что не удалось покрыть.
model HiringResourceRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  trigger    String // всегда "manual" — обновление источников запускается только кнопкой в приложении, без крона
  // "running" | "done" | "stopped" | "error" — приложение опрашивает это
  // поле, чтобы показать статус-бар во время долгого поиска. "stopped" —
  // пользователь нажал "Остановить", в отличие от "error" это не сбой.
  status     String    @default("running")
  // Пользователь запросил остановку (POST /runs/:id/stop) — агент проверяет
  // этот флаг между шагами поиска и завершает работу с уже найденным вместо
  // ожидания собственного решения модели закончить.
  stopRequested Boolean @default(false)

  // Входные параметры запуска, включая явные допущения по незаданным
  // полям — см. HiringResourceRunParams в src/discovery/types.ts.
  paramsJson String

  confirmedCount   Int @default(0)
  needsReviewCount Int @default(0)
  excludedCount    Int @default(0)
  organizationCount Int @default(0)

  // Список категорий/условий, которые не удалось покрыть (п.10) — JSON-массив строк.
  limitations String @default("[]")

  queriesUsed Int @default(0)
  error       String?

  resources HiringResource[]
}
