generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Source {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  // "api" | "ats" | "rss" — SQLite не поддерживает enum в Prisma, проверяется в коде.
  kind      String
  country   String?
  enabled   Boolean  @default(true)
  // true — источник появился сам через ежедневное автообнаружение (см. SourceCandidate),
  // а не был добавлен вручную через seed/БД.
  discovered Boolean @default(false)
  // Free-form per-connector config, e.g. {"provider":"greenhouse","boardSlug":"acme"} or {"feedUrl":"https://..."}
  config    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vacancies Vacancy[]
}

// Каталог кандидатов на добавление в мониторинг (сайты рекрутинговых
// компаний/агентств). Пользователь пополняет каталог сам (через API/приложение,
// т.к. у нас нет достоверного списка конкретных агентств) — при ежедневном
// автообнаружении каждый ещё не подтверждённый кандидат проверяется, и если
// ресурс реально отдаёт вакансии, для него автоматически создаётся Source
// (список источников поиска), после чего он участвует в обычном скане вакансий.
model SourceCandidate {
  id               String    @id @default(cuid())
  key              String    @unique
  name             String
  // "ats" | "rss"
  kind             String
  country          String?
  config           String
  addedAt          DateTime  @default(now())
  lastCheckedAt    DateTime?
  lastCheckOk      Boolean?
  lastCheckError   String?
  promotedSourceId String?   @unique
}

// Список названий должностей, которые пользователь ведёт заранее.
// При поиске используются только те, у которых selected = true.
model JobTitle {
  id        String   @id @default(cuid())
  title     String   @unique
  selected  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Остальные критерии поиска (без свободного текста по названию должности —
// оно берётся из выбранных JobTitle). Единственная запись в таблице.
model SearchCriteria {
  id             String   @id @default("singleton")
  location       String?
  employmentType String?
  salaryMin      Int?
  remoteOnly     Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model Vacancy {
  id          String   @id @default(cuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id])
  externalId  String
  title       String
  company     String?
  url         String
  location    String?
  salaryText  String?
  publishedAt DateTime
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  state             VacancyState?
  notificationLog   NotificationLog?

  @@unique([sourceId, externalId])
  @@index([publishedAt])
}

model VacancyState {
  vacancyId String   @id
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  hidden    Boolean  @default(false)
  // false, пока пользователь не открывал список вакансий после появления этой
  // записи — управляет значком "Новое" и счётчиком в приложении.
  seen      Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Наличие записи означает, что по этой вакансии уже было отправлено письмо.
model NotificationLog {
  vacancyId  String   @id
  vacancy    Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  notifiedAt DateTime @default(now())
}

// Журнал запусков скана — для отображения в приложении времени/результата последнего скана.
model ScanRun {
  id           String   @id @default(cuid())
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  trigger      String // "cron" | "manual"
  newVacancies Int      @default(0)
  emailSent    Boolean  @default(false)
  error        String?
}

// Журнал запусков автообнаружения новых источников (см. SourceCandidate).
model DiscoveryRun {
  id             String   @id @default(cuid())
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  trigger        String // "cron" | "manual"
  checked        Int      @default(0)
  promoted       Int      @default(0)
  error          String?
}
